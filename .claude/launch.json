{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "geoexplora-web",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "geoexplora.web",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "terravisao-app",
      "runtimeExecutable": ".venv/Scripts/streamlit.exe",
      "runtimeArgs": [
        "run",
        "app/streamlit_app.py",
        "--server.port",
        "8501"
      ],
      "port": 8501
    }
  ]
}
